---
import Base from "../../layouts/Base.astro";
import Cover from "../../components/Cover.astro";
import {getCollection, render} from "astro:content";
import {
  publishedPosts,
  readingMinutes,
  tagSlug,
  assertCaseStudyHeadings
} from "../../lib/blog";
import {blogPostingSchema, breadcrumbSchema} from "../../lib/schema";

export async function getStaticPaths() {
  const posts = publishedPosts(await getCollection("blog"));
  return posts.map(post => ({params: {slug: post.id}, props: {post, posts}}));
}

const {post, posts} = Astro.props;
const data = post.data;
const date = data.date.toISOString().slice(0, 10);
const KIND_LABEL = {"case-study": "Case study", note: "Note"};

const index = posts.findIndex(item => item.id === post.id);
const previous = posts[index - 1];
const next = posts[index + 1];

const {Content, headings} = await render(post);
assertCaseStudyHeadings(post, headings);
const anchors = headings.filter(heading => heading.depth === 2);
const minutes = readingMinutes(post);

const title = `${data.title} | Abdelwahab Mahmoud`;
const description = data.lede;

const jsonLd = [
  blogPostingSchema(post),
  breadcrumbSchema([
    {name: "Home", url: "https://abdelwahab.dev/"},
    {name: "Blog", url: "https://abdelwahab.dev/blog"},
    {name: data.title, url: `https://abdelwahab.dev/blog/${post.id}`}
  ])
];
---

<Base {title} {description} date={data.date} {jsonLd}>
  <article class="post">
    <nav class="post-crumbs" aria-label="Breadcrumb">
      <a href="/blog">Blog</a>
      {
        data.tags.length > 0 && (
          <>
            <span class="crumb-sep">/</span>
            <a href={`/blog/tag/${tagSlug(data.tags[0])}`}>#{data.tags[0]}</a>
          </>
        )
      }
    </nav>

    <header class="post-head">
      <div class="post-meta">
        <time datetime={date}>{date}</time>
        <span class="post-kind">{KIND_LABEL[data.kind]}</span>
        {data.status === "draft" && <span class="post-draft">Draft</span>}
        <span class="post-read">{minutes} min read</span>
      </div>
      <h1 class="post-title">{data.title}</h1>
      {
        data.cover && (
          <figure class="post-cover">
            <Cover src={data.cover} alt={data.coverAlt ?? ""} />
          </figure>
        )
      }
      <p class="post-lede">{data.lede}</p>
      <ul class="post-tags">
        {
          data.tags.map(tag => (
            <li class="post-tag">
              <a href={`/blog/tag/${tagSlug(tag)}`}>{tag}</a>
            </li>
          ))
        }
      </ul>
    </header>

    {
      anchors.length > 0 && (
        <nav class="post-toc" aria-label="On this page">
          <span class="post-toc-label">On this page</span>
          <ol>
            {anchors.map(anchor => (
              <li>
                <a href={`#${anchor.slug}`}>{anchor.text}</a>
              </li>
            ))}
          </ol>
        </nav>
      )
    }

    <div class="post-body">
      <Content />
    </div>

    <nav class="post-nav">
      {
        previous ? (
          <a class="post-nav-prev" href={`/blog/${previous.id}`} rel="prev">
            ← {previous.data.title}
          </a>
        ) : (
          <span />
        )
      }
      {
        next && (
          <a class="post-nav-next" href={`/blog/${next.id}`} rel="next">
            {next.data.title} →
          </a>
        )
      }
    </nav>
  </article>
</Base>

---
import Base from "../layouts/Base.astro";
import ArrowUpRight from "../components/ArrowUpRight.astro";
import {getCollection} from "astro:content";
import {homeGraph} from "../lib/schema";
import {publishedPosts, assertArticlesExist} from "../lib/blog";
import {
  greeting,
  socialMediaLinks,
  cvStack,
  educationInfo,
  workExperiences,
  openSource,
  contactInfo
} from "../data/portfolio";

const title =
  "Abdelwahab Mahmoud | Senior Software Engineer, Full-stack & Platform";
const description =
  "Abdelwahab Mahmoud, senior full-stack and platform engineer in Cairo. React, Next.js and React Native, Ruby on Rails and Node.js, AWS (ECS Fargate, Lambda, Terraform) and LLM platforms over Bedrock, OpenAI and Gemini. Eight years building and operating production systems.";

const facts = [
  {key: "Location", value: "Cairo, Egypt"},
  {key: "Core stack", value: "React, Rails, Node.js, AWS"},
  {key: "Experience", value: "8+ years"},
  {key: "Languages", value: "English, Arabic"}
];

const skillGroups = [
  {label: "Languages", items: cvStack.languages},
  {label: "Backend", items: cvStack.backend},
  {label: "Frontend", items: cvStack.frontend},
  {label: "AI & LLM", items: cvStack.ai_llm},
  {label: "Cloud & Infrastructure", items: cvStack.cloud},
  {label: "Observability", items: cvStack.observability},
  {label: "Databases", items: cvStack.databases},
  {label: "Testing", items: cvStack.testing},
  {label: "Compatibility & i18n", items: cvStack.compatibility},
  {label: "Spoken Languages", items: cvStack.spoken}
];

const SHOWN_BULLETS = 3;
const jobs = workExperiences.experience.map(job => {
  const split =
    job.descBullets.length > SHOWN_BULLETS + 1 ? SHOWN_BULLETS : undefined;
  return {
    job,
    shown: job.descBullets.slice(0, split),
    rest: split ? job.descBullets.slice(split) : []
  };
});

const education = educationInfo.schools[0];

const KIND_LABEL = {"case-study": "Case study", note: "Note"};
const allPosts = await getCollection("blog");
const published = publishedPosts(allPosts);
assertArticlesExist(
  published,
  workExperiences.experience.map(job => job.article)
);
const postBySlug = new Map(published.map(post => [post.id, post]));
const writing = published.slice(0, 3);
---

<Base {title} {description} jsonLd={[homeGraph()]}>
  <!-- hero -->
  <section class="container hero">
    <h1>{greeting.title}</h1>
    <p class="hero-role">{greeting.subTitle}</p>
    <p class="hero-lede">{greeting.valueProp}</p>
    <div class="hero-actions">
      <a class="btn btn-primary" href={greeting.resumeLink} data-track="cv"
        >Resume <ArrowUpRight /></a
      >
      <a
        class="btn"
        href={greeting.githubLink}
        target="_blank"
        rel="noopener noreferrer"
        data-track="github">GitHub</a
      >
      <a
        class="btn"
        href={greeting.linkedinLink}
        target="_blank"
        rel="noopener noreferrer"
        data-track="linkedin">LinkedIn</a
      >
      <a class="btn" href="#contact" data-track="contact">Email</a>
    </div>
  </section>

  <!-- about -->
  <section class="container section" id="about">
    <div class="section-head">
      <h2 class="section-title">About</h2>
    </div>
    <div class="about-grid">
      <div class="about-body">
        <p class="lead">
          I studied geophysics, then started in software in 2018 on Extreme
          Programming teams: pair programming, the test written first, small
          slices shipped continuously. Most of how I work still comes from
          there.
        </p>
        <p>
          I work across the stack: React, Next.js and React Native in the
          product, Rails and Node.js services behind it, and the AWS platform
          and databases underneath. The last few years leaned toward the
          platform half: autoscaling, database load and LLM provider failover.
        </p>
        <p>
          I like owning a system from the architecture decision to the incident
          review. When production breaks, I write down what is verified and what
          is only inferred before I change anything. The write-ups on this site
          come out of that habit.
        </p>
      </div>
      <aside class="fact-card" aria-label="Quick facts">
        <h3>At a glance</h3>
        {
          facts.map(fact => (
            <div class="fact-row">
              <span class="fact-key">{fact.key}</span>
              <span class="fact-val">{fact.value}</span>
            </div>
          ))
        }
      </aside>
    </div>
  </section>

  <!-- experience -->
  <section class="container section" id="experience">
    <div class="section-head">
      <h2 class="section-title">Experience</h2>
    </div>
    <ol class="jobs">
      {
        jobs.map(({job, shown, rest}) => (
          <li class="job">
            <p class="job-meta">
              <span class="co">{job.date}</span>
              {job.duration} · {job.location}
            </p>
            <div class="job-body">
              <h3 class="job-company">
                {job.companylogo && (
                  <img src={job.companylogo} alt="" width="26" height="26" />
                )}
                {job.company}
              </h3>
              <p class="job-role">{job.role}</p>
              <h4 class="job-headline">{job.headline}</h4>
              <p class="job-desc">{job.story}</p>
              <p class="job-links">
                {job.product && (
                  <a href={job.product.url} target="_blank" rel="noreferrer">
                    {job.product.name} <ArrowUpRight />
                  </a>
                )}
                {postBySlug.get(job.article) && (
                  <a href={`/blog/${job.article}`}>
                    Write-up: {postBySlug.get(job.article)!.data.title}{" "}
                    <span class="arrow">→</span>
                  </a>
                )}
              </p>
              <ul class="job-bullets">
                {shown.map(bullet => (
                  <li>{bullet}</li>
                ))}
              </ul>
              {rest.length > 0 && (
                <details class="job-more">
                  <summary>Show {rest.length} more</summary>
                  <ul class="job-bullets">
                    {rest.map(bullet => (
                      <li>{bullet}</li>
                    ))}
                  </ul>
                </details>
              )}
              <ul class="tags" aria-label="Tech at job">
                {job.tags.map(tag => (
                  <li class="tag">{tag}</li>
                ))}
              </ul>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- writing -->
  <section class="container section" id="writing">
    <div class="section-head">
      <h2 class="section-title">Writing</h2>
    </div>
    <div class="write-grid">
      {
        writing.map(post => (
          <a class="write-card" href={`/blog/${post.id}`}>
            <span class="write-kind">{KIND_LABEL[post.data.kind]}</span>
            <h3>{post.data.title}</h3>
            <p>{post.data.lede}</p>
            <div class="write-meta">
              {post.data.date.toISOString().slice(0, 10)} ·{" "}
              {post.data.tags.join(" · ")}
            </div>
          </a>
        ))
      }
    </div>
    <div class="section-cta">
      <a class="link-arrow" href="/blog">
        Read all writing <span class="arrow">→</span>
      </a>
    </div>
  </section>

  <!-- open source -->
  <section class="container section" id="opensource">
    <div class="section-head">
      <h2 class="section-title">Open source</h2>
    </div>
    <ul class="os-list">
      {
        openSource.projects.map(project => (
          <li class="os-item">
            <a
              class="os-name"
              href={project.url}
              target="_blank"
              rel="noopener noreferrer"
            >
              {project.name}
            </a>
            <span class="os-desc">
              {project.desc} {project.role} · {project.outcome}
            </span>
            <span class="os-meta">{project.tags.join(" · ")}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- skills -->
  <section class="container section" id="skills">
    <div class="section-head">
      <h2 class="section-title">Skills</h2>
    </div>
    <div class="skills">
      {
        skillGroups.map(group => (
          <div class="skill-group">
            <h3>{group.label}</h3>
            <ul>
              {group.items.map(item => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>

  <!-- education -->
  <section class="container section" id="education">
    <div class="section-head">
      <h2 class="section-title">Education</h2>
    </div>
    <div class="edu">
      <img
        class="edu-badge-img"
        src={education.logo}
        alt={`${education.schoolName} logo`}
        width="277"
        height="359"
      />
      <div>
        <h3 class="edu-name">{education.schoolName}</h3>
        <p class="edu-sub">{education.subHeader}</p>
      </div>
      <span class="edu-duration">{education.duration}</span>
    </div>
  </section>

  <!-- contact -->
  <section class="container section" id="contact">
    <div class="contact">
      <p class="kicker">Contact</p>
      <h2>{contactInfo.title}</h2>
      <p>{contactInfo.subtitle}</p>
      <a
        class="contact-email"
        href={`mailto:${contactInfo.email_address}`}
        data-track="contact">{contactInfo.email_address}</a
      >
      <div class="contact-actions">
        <a class="btn btn-primary" href={greeting.resumeLink} data-track="cv"
          >Resume <ArrowUpRight /></a
        >
        <a
          class="btn"
          href={socialMediaLinks.linkedin}
          target="_blank"
          rel="noopener noreferrer">LinkedIn</a
        >
        <a
          class="btn"
          href={socialMediaLinks.github}
          target="_blank"
          rel="noopener noreferrer">GitHub</a
        >
      </div>
    </div>
  </section>
</Base>

---
import Base from "../layouts/Base.astro";
import ArrowUpRight from "../components/ArrowUpRight.astro";
import WorkGrid from "../components/WorkGrid.astro";
import {getCollection} from "astro:content";
import {homeGraph, productListSchema} from "../lib/schema";
import {publishedPosts, assertArticlesExist} from "../lib/blog";
import {
  greeting,
  socialMediaLinks,
  cvStack,
  skillsSection,
  educationInfo,
  workExperiences,
  bigProjects,
  openSource,
  contactInfo,
  workChallenges
} from "../data/portfolio";

const title =
  "Abdelwahab Mahmoud | Senior Software Engineer, Full-stack & Platform";
const description =
  "Abdelwahab Mahmoud, senior software engineer in Cairo. Ruby on Rails, AWS (ECS Fargate, Lambda, Terraform) and LLM platforms over Bedrock, OpenAI and Gemini. Eight years building and operating production systems.";

const facts = [
  {key: "Location", value: "Cairo, Egypt"},
  {key: "Focus", value: "Full-stack & Platform"},
  {key: "Experience", value: "8+ years"},
  {key: "Languages", value: "English, Arabic"}
];

const skillGroups = [
  {label: "Languages", items: cvStack.languages},
  {label: "Backend", items: cvStack.backend},
  {label: "Frontend", items: cvStack.frontend},
  {label: "AI & LLM", items: cvStack.ai_llm},
  {label: "Cloud & Infrastructure", items: cvStack.cloud},
  {label: "Observability", items: cvStack.observability},
  {label: "Databases", items: cvStack.databases},
  {label: "Testing", items: cvStack.testing},
  {label: "WordPress & Compatibility", items: cvStack.wordpress},
  {label: "Spoken Languages", items: cvStack.spoken}
];

const jobs = workExperiences.experience.map(job => ({
  job,
  shown: job.descBullets.slice(0, 3),
  rest: job.descBullets.slice(3)
}));

const education = educationInfo.schools[0];

const KIND_LABEL = {"case-study": "Case study", note: "Note"};
const allPosts = await getCollection("blog");
const published = publishedPosts(allPosts);
assertArticlesExist(
  published,
  workChallenges.cards.map(card => card.article)
);
const writing = published.slice(0, 4);
---

<Base {title} {description} jsonLd={[homeGraph(), productListSchema()]}>
  <!-- hero -->
  <section class="container hero">
    <h1>{greeting.title}</h1>
    <p class="hero-role">{greeting.subTitle}</p>
    <p class="hero-lede">{greeting.valueProp}</p>
    <ul class="quick-facts">
      {greeting.chips.map(fact => <li>{fact}</li>)}
    </ul>
    <div class="hero-actions">
      <a class="btn btn-primary" href={greeting.resumeLink} data-track="cv"
        >Resume <ArrowUpRight /></a
      >
      <a
        class="btn"
        href={greeting.githubLink}
        target="_blank"
        rel="noopener noreferrer"
        data-track="github">GitHub</a
      >
      <a
        class="btn"
        href={greeting.linkedinLink}
        target="_blank"
        rel="noopener noreferrer"
        data-track="linkedin">LinkedIn</a
      >
      <a class="btn" href="#contact" data-track="contact">Email</a>
    </div>
    <div class="hero-shipped">
      <span class="hero-shipped-label">Recently shipped</span>
      <ul>
        {
          bigProjects.projects.slice(0, 3).map(product => (
            <li>
              <a
                href={product.footerLink[0]?.url}
                target="_blank"
                rel="noreferrer"
              >
                {product.projectName} <ArrowUpRight />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- about -->
  <section class="container section" id="about">
    <div class="section-head">
      <h2 class="section-title">About</h2>
    </div>
    <div class="about-grid">
      <div class="about-body">
        <p class="lead">
          I'm a senior software engineer based in Cairo. For eight years I've
          built and operated real products end to end, with backend and platform
          as my home ground.
        </p>
        <p>
          Most of my work is the unglamorous kind that keeps a product standing:
          keeping a database out of CPU saturation, replacing autoscaling that
          killed long-running jobs, and making an LLM engine fail over cleanly
          when a provider degrades. I like owning a system from the architecture
          decision to the incident at 3am.
        </p>
        <p>
          I've worked on a meal subscription platform serving 100K daily users,
          a US health product, and the AI translation platform behind WPML.
        </p>
      </div>
      <aside class="fact-card" aria-label="Quick facts">
        <h3>At a glance</h3>
        {
          facts.map(fact => (
            <div class="fact-row">
              <span class="fact-key">{fact.key}</span>
              <span class="fact-val">{fact.value}</span>
            </div>
          ))
        }
      </aside>
    </div>
  </section>

  <!-- work -->
  <WorkGrid />

  <!-- writing -->
  <section class="container section" id="writing">
    <div class="section-head">
      <h2 class="section-title">Writing</h2>
    </div>
    <div class="write-grid">
      {
        writing.map(post => (
          <a class="write-card" href={`/blog/${post.id}`}>
            <span class="write-kind">{KIND_LABEL[post.data.kind]}</span>
            <h3>{post.data.title}</h3>
            <p>{post.data.lede}</p>
            <div class="write-meta">
              {post.data.date.toISOString().slice(0, 10)} ·{" "}
              {post.data.tags.join(" · ")}
            </div>
          </a>
        ))
      }
    </div>
    <div class="section-cta">
      <a class="link-arrow" href="/blog">
        Read all writing <span class="arrow">→</span>
      </a>
    </div>
  </section>

  <!-- experience -->
  <section class="container section" id="experience">
    <div class="section-head">
      <h2 class="section-title">Experience</h2>
    </div>
    <ol class="jobs">
      {
        jobs.map(({job, shown, rest}) => (
          <li class="job">
            <p class="job-meta">
              <span class="co">{job.date}</span>
              {job.duration} · {job.location}
            </p>
            <div class="job-body">
              <h3 class="job-company">
                <img src={job.companylogo} alt="" width="26" height="26" />
                {job.company}
              </h3>
              <p class="job-role">{job.role}</p>
              <p class="job-desc">{job.desc}</p>
              <ul class="job-bullets">
                {shown.map(bullet => (
                  <li>{bullet}</li>
                ))}
              </ul>
              {rest.length > 0 && (
                <details class="job-more">
                  <summary>Show {rest.length} more</summary>
                  <ul class="job-bullets">
                    {rest.map(bullet => (
                      <li>{bullet}</li>
                    ))}
                  </ul>
                </details>
              )}
              <ul class="tags" aria-label="Tech at job">
                {job.tags.map(tag => (
                  <li class="tag">{tag}</li>
                ))}
              </ul>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- products -->
  <section class="container section" id="products">
    <div class="section-head">
      <h2 class="section-title">Products</h2>
    </div>
    <div class="card-grid">
      {
        bigProjects.projects.map(product => (
          <article class="card">
            <span class="logo-badge">{product.badge}</span>
            <h3>{product.projectName}</h3>
            <p class="card-tagline">{product.tagline}</p>
            <dl class="card-meta">
              <div class="card-row">
                <dt>Overview</dt>
                <dd>{product.projectDesc}</dd>
              </div>
              {product.scale && (
                <div class="card-row">
                  <dt>Scale</dt>
                  <dd>{product.scale}</dd>
                </div>
              )}
              {product.timeframe && (
                <div class="card-row">
                  <dt>Time</dt>
                  <dd>{product.timeframe}</dd>
                </div>
              )}
              <div class="card-row">
                <dt>Stack</dt>
                <dd>
                  <ul class="tags" aria-label="Product stack">
                    {product.stack.map(tech => (
                      <li class="tag">{tech}</li>
                    ))}
                  </ul>
                </dd>
              </div>
            </dl>
            <div class="card-link">
              {product.footerLink.map(link => (
                <a href={link.url} target="_blank" rel="noreferrer">
                  {link.name} <ArrowUpRight />
                </a>
              ))}
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <!-- open source -->
  <section class="container section" id="opensource">
    <div class="section-head">
      <h2 class="section-title">Open source</h2>
    </div>
    <ul class="os-list">
      {
        openSource.projects.map(project => (
          <li class="os-item">
            <a
              class="os-name"
              href={project.url}
              target="_blank"
              rel="noopener noreferrer"
            >
              {project.name}
            </a>
            <span class="os-desc">
              {project.desc} {project.role} · {project.outcome}
            </span>
            <span class="os-meta">{project.tags.join(" · ")}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- skills -->
  <section class="container section" id="skills">
    <div class="section-head">
      <h2 class="section-title">Skills</h2>
    </div>
    <p class="section-lede">{skillsSection.subTitle}</p>
    <div class="skills">
      {
        skillGroups.map(group => (
          <div class="skill-group">
            <h3>{group.label}</h3>
            <ul>
              {group.items.map(item => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>

  <!-- education -->
  <section class="container section" id="education">
    <div class="section-head">
      <h2 class="section-title">Education</h2>
    </div>
    <div class="edu">
      <img
        class="edu-badge-img"
        src={education.logo}
        alt={`${education.schoolName} logo`}
        width="277"
        height="359"
      />
      <div>
        <h3 class="edu-name">{education.schoolName}</h3>
        <p class="edu-sub">{education.subHeader}</p>
      </div>
      <span class="edu-duration">{education.duration}</span>
    </div>
  </section>

  <!-- contact -->
  <section class="container section" id="contact">
    <div class="contact">
      <p class="kicker">Contact</p>
      <h2>{contactInfo.title}</h2>
      <p>{contactInfo.subtitle}</p>
      <a
        class="contact-email"
        href={`mailto:${contactInfo.email_address}`}
        data-track="contact">{contactInfo.email_address}</a
      >
      <div class="contact-actions">
        <a class="btn btn-primary" href={greeting.resumeLink} data-track="cv"
          >Resume <ArrowUpRight /></a
        >
        <a
          class="btn"
          href={socialMediaLinks.linkedin}
          target="_blank"
          rel="noopener noreferrer">LinkedIn</a
        >
        <a
          class="btn"
          href={socialMediaLinks.github}
          target="_blank"
          rel="noopener noreferrer">GitHub</a
        >
      </div>
      <div class="contact-facts">
        <span>
          github → <a
            href={socialMediaLinks.github}
            target="_blank"
            rel="noopener noreferrer">{socialMediaLinks.github}</a
          >
        </span>
        <span>
          linkedin → <a
            href={socialMediaLinks.linkedin}
            target="_blank"
            rel="noopener noreferrer">{socialMediaLinks.linkedin}</a
          >
        </span>
      </div>
    </div>
  </section>
</Base>
